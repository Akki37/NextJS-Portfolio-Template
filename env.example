# Copy to .env.local for local dev (never commit .env.local).
#
# Resume PDF is hosted on Vercel Blob, not in this repo.
# Replace the placeholder with your own public Blob URL.

NEXT_PUBLIC_RESUME_PDF_URL=https://your-store.public.blob.vercel-storage.com/vikas-goswami-resume

# Optional. Bump when the Blob URL stays the same but the PDF contents change.
# NEXT_PUBLIC_RESUME_PDF_VERSION=1
